# Backend (server/)
TMDB_API_KEY=            # v3 API key or v4 read access token from themoviedb.org/settings/api
MOVIES_DIR=~/Movies      # folder with your movie files (scanned recursively)
PORT=4000
# TMDB_LANGUAGE=en-US    # e.g. hu-HU for Hungarian descriptions (and localized titles)

# Frontend: only needed if the API is not served via the Vite proxy
# VITE_API_URL=http://localhost:4000/api

# GEMINI_MODEL=gemini-3.8-flash   # model used to pick title styles
GEMINI_API_KEY=          # from aistudio.google.com
# GEMINI_ASSISTANT_MODEL=gemini-3.5-flash-lite   # chat + recommendations (fast); GEMINI_MODEL above is only for title styles
